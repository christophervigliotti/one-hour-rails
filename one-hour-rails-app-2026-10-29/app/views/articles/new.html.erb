<h1>Articles#new</h1>
<p>Find me in app/views/articles/new.html.erb</p>
<%= form_with model: @article, local: true do |form| %>
  <div>
    <%= form.label :title %>
    <%= form.text_field :title %>
  </div>
  <div>
    <%= form.label :body %>
    <%= form.text_area :body %>
  </div>
  <div>
    <%= form.submit "Create Article" %>
  </div>
<% end %>
<%= link_to "Back to Articles", articles_path %>
